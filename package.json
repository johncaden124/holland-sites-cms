{
  "name": "@hollandtech/site-cms",
  "version": "0.8.0",
  "type": "module",
  "description": "Shared Payload-hub content layer for Holland Tech's niche website templates.",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "schema",
    "consumers.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./photo": {
      "types": "./dist/photo.d.ts",
      "default": "./dist/photo.js"
    },
    "./media-origins": {
      "types": "./dist/mediaOrigins.d.ts",
      "default": "./dist/mediaOrigins.js"
    },
    "./service-icons": {
      "types": "./dist/serviceIcons.d.ts",
      "default": "./dist/serviceIcons.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./content-file": {
      "types": "./dist/contentFile.d.ts",
      "default": "./dist/contentFile.js"
    },
    "./trades": {
      "types": "./dist/trades.d.ts",
      "default": "./dist/trades.js"
    },
    "./schema": "./schema/site-content.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "site-cms": "./bin/site-cms.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "schema": "node scripts/build-schema.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "api:report": "node scripts/api-report.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "check:schema": "node scripts/build-schema.mjs --check",
    "check:service-icons": "node scripts/check-service-icons.mjs",
    "check:version-bump": "node scripts/check-version-bump.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "astro": {
    "external": true
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@types/node": "22.20.1",
    "ajv": "^8.20.0",
    "astro": "^7.1.6",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.7.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
