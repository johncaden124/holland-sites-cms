{
  "$id": "https://github.com/johncaden124/holland-sites-cms/schema/site-content.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LocalContent",
  "definitions": {
    "LocalContent": {
      "type": "object",
      "properties": {
        "site": {
          "$ref": "#/definitions/SiteContent"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Service"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GalleryImage"
          }
        },
        "testimonials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Testimonial"
          }
        },
        "process": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProcessStep"
          }
        },
        "stats": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Stat"
          }
        },
        "faqs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Faq"
          }
        }
      },
      "required": [
        "site",
        "services",
        "projects",
        "testimonials",
        "process",
        "stats",
        "faqs"
      ],
      "additionalProperties": false,
      "description": "A template's own `src/data` assembled into the shapes the mappers return, so components consume the getters without caring whether the content came from the hub or from the repo."
    },
    "SiteContent": {
      "type": "object",
      "properties": {
        "site": {
          "$ref": "#/definitions/SiteSettings"
        },
        "hero": {
          "$ref": "#/definitions/HeroMedia"
        },
        "aboutHeading": {
          "type": "string"
        },
        "trustCard": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "bullets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "body",
            "bullets"
          ],
          "additionalProperties": false
        },
        "aboutCards": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AboutCard"
          }
        },
        "servicesIntro": {
          "$ref": "#/definitions/Intro"
        },
        "workIntro": {
          "$ref": "#/definitions/Intro"
        },
        "featuredProject": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "subtitle"
          ],
          "additionalProperties": false
        },
        "testimonialsIntro": {
          "$ref": "#/definitions/ShortIntro"
        },
        "impactIntro": {
          "$ref": "#/definitions/ShortIntro"
        },
        "processIntro": {
          "$ref": "#/definitions/Intro"
        },
        "faqIntro": {
          "$ref": "#/definitions/Intro"
        },
        "faqSideCard": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "cta": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "body",
            "cta",
            "href"
          ],
          "additionalProperties": false
        },
        "ctaBand": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string"
            },
            "copy": {
              "type": "string"
            },
            "button": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "heading",
            "copy",
            "button",
            "href"
          ],
          "additionalProperties": false
        },
        "ctaStrip": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "$ref": "#/definitions/Photo"
              },
              "alt": {
                "type": "string"
              }
            },
            "required": [
              "image",
              "alt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "site",
        "hero",
        "aboutHeading",
        "trustCard",
        "aboutCards",
        "servicesIntro",
        "workIntro",
        "featuredProject",
        "testimonialsIntro",
        "impactIntro",
        "processIntro",
        "faqIntro",
        "faqSideCard",
        "ctaBand",
        "ctaStrip"
      ],
      "additionalProperties": false,
      "description": "Everything on the page that is not one of the six list collections; `getSite()` returns it."
    },
    "SiteSettings": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tagline": {
          "type": "string",
          "description": "Suffix of the `<title>`, not a heading — the H1 is `heroHeadline`."
        },
        "description": {
          "type": "string"
        },
        "heroHeadline": {
          "type": "string",
          "description": "The hero H1. One rendered line per `\\n`, so a client can set their own two-line headline."
        },
        "heroEyebrow": {
          "type": "string",
          "description": "The hero's chip, above the H1 — the one section that had no `chip` of its own. Optional because it is a design element, not a fact: a template renders it only when a client sets it (\"24/7 emergency · Greater Columbus\"), so a niche whose hero has no room for one omits it."
        },
        "nav": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NavLink"
          }
        },
        "navCta": {
          "$ref": "#/definitions/NavLink",
          "description": "The nav pill's call to action."
        },
        "heroCta": {
          "$ref": "#/definitions/NavLink",
          "description": "The hero's primary call to action."
        },
        "heroPhone": {
          "type": "object",
          "properties": {
            "display": {
              "type": "string"
            },
            "tel": {
              "type": "string"
            }
          },
          "required": [
            "display",
            "tel"
          ],
          "additionalProperties": false,
          "description": "Phone shown in the hero (\"Call us\" line)"
        },
        "footer": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "object",
              "properties": {
                "display": {
                  "type": "string"
                },
                "tel": {
                  "type": "string"
                }
              },
              "required": [
                "display",
                "tel"
              ],
              "additionalProperties": false
            },
            "address": {
              "type": "string"
            },
            "serviceArea": {
              "type": "string",
              "description": "Where the business works (\"Greater Columbus, OH\"). Optional: emergency trades sell it as a first-class fact and templates give it a footer column, but a niche that does not show one omits it rather than inventing copy."
            },
            "hours": {
              "type": "string",
              "description": "When they answer (\"24/7\", \"Mon-Fri 7am-6pm\"). Optional for the same reason."
            }
          },
          "required": [
            "email",
            "phone",
            "address"
          ],
          "additionalProperties": false,
          "description": "Contact details shown in the footer"
        },
        "review": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false
        },
        "heroBadge": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "value",
            "label"
          ],
          "additionalProperties": false,
          "description": "The hero's value + label badge (\"98% / Would recommend our service\", \"24/7 / A real dispatcher\"). Named for what it is rather than what the first template put in it."
        },
        "licenseNumber": {
          "type": "string",
          "description": "Contractor licence number, displayed near the copyright. Several regulated trades must show one by law; optional because just as many have none."
        },
        "labels": {
          "type": "object",
          "properties": {
            "callPrefix": {
              "type": "string",
              "description": "Precedes the phone number on the \"call us\" buttons."
            },
            "footerEmail": {
              "type": "string",
              "description": "Headings above the footer contact columns."
            },
            "footerPhone": {
              "type": "string"
            },
            "footerAddress": {
              "type": "string"
            },
            "footerServiceArea": {
              "type": "string",
              "description": "Headings for the two optional footer columns; unused when their field is unset."
            },
            "footerHours": {
              "type": "string"
            }
          },
          "required": [
            "callPrefix",
            "footerEmail",
            "footerPhone",
            "footerAddress",
            "footerServiceArea",
            "footerHours"
          ],
          "additionalProperties": false,
          "description": "Short interface strings components would otherwise hard-code, so every niche can reword them."
        },
        "socials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Social"
          }
        },
        "copyright": {
          "type": "string"
        },
        "business": {
          "$ref": "#/definitions/BusinessProfile",
          "description": "Structured business facts (v0.6). Optional: a v0.5 site has none."
        },
        "pricing": {
          "$ref": "#/definitions/PricingSection",
          "description": "Published prices (v0.8). Absent for a business that quotes every job; a template then renders no pricing section rather than an empty one."
        },
        "promos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short promotional lines for a ticker or banner (v0.8): \"Furnace check-up $89 this month\". Absent or empty means no ticker."
        },
        "copy": {
          "$ref": "#/definitions/CopyInputs",
          "description": "The generator's copy inputs (v0.6)."
        },
        "flags": {
          "$ref": "#/definitions/SiteFlags"
        },
        "emergency": {
          "$ref": "#/definitions/EmergencyService",
          "description": "Emergency calls (v0.9, HVAC). Absent: a template shows no emergency wording at all. Stored on the hub's `trade-details` document, like every v0.9 trade fact."
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HvacSystem"
          },
          "description": "The systems an HVAC business works on (v0.9), in display order. Absent or empty: not shown."
        },
        "serviceSeason": {
          "$ref": "#/definitions/ServiceSeason",
          "description": "The months a seasonal business works (v0.9, landscaping). Absent: year-round, or not said."
        }
      },
      "required": [
        "name",
        "tagline",
        "description",
        "heroHeadline",
        "nav",
        "navCta",
        "heroCta",
        "heroPhone",
        "footer",
        "review",
        "heroBadge",
        "labels",
        "socials",
        "copyright"
      ],
      "additionalProperties": false,
      "description": "Site-wide settings — the hub's `site` global, one document per tenant."
    },
    "NavLink": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "Social": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "x",
            "linkedin",
            "facebook",
            "instagram",
            "yelp",
            "nextdoor",
            "youtube",
            "tiktok"
          ],
          "description": "Which network; a template picks the glyph and the accessible name by it. There is deliberately no `google`: the Google Business Profile link is `business.gbp.url`, and a template that shows a Google icon renders it from there rather than from a second copy of the same URL."
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "BusinessProfile": {
      "type": "object",
      "properties": {
        "trade": {
          "$ref": "#/definitions/Trade"
        },
        "town": {
          "type": "string",
          "description": "The home town the copy leads with (\"Westerville\")."
        },
        "serviceAreaTowns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every town the business serves, home town included, in the order to list them."
        },
        "address": {
          "$ref": "#/definitions/PostalAddress"
        },
        "geo": {
          "$ref": "#/definitions/Geo"
        },
        "openingHours": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpeningHours"
          }
        },
        "phone": {
          "type": "object",
          "properties": {
            "e164": {
              "type": "string",
              "description": "E.164: `+` then country code and number, no spaces (\"+16145550123\").",
              "pattern": "^\\+[1-9]\\d{7,14}$"
            },
            "display": {
              "type": "string",
              "description": "How to print it (\"(614) 555-0123\"). Absent: a template formats `e164` itself."
            }
          },
          "required": [
            "e164"
          ],
          "additionalProperties": false
        },
        "email": {
          "type": "string"
        },
        "siteUrl": {
          "type": "string",
          "description": "The site's canonical origin, `https://` and no path (\"https://acme-hvac.com\").",
          "pattern": "^https://[^/]+$"
        },
        "gbp": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "placeId": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "placeId"
          ],
          "additionalProperties": false,
          "description": "Google Business Profile."
        },
        "reviews": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "minimum": 0
            },
            "rating": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "required": [
            "count",
            "rating"
          ],
          "additionalProperties": false,
          "description": "The review summary the site quotes. `site.review.summary` is its rendered sentence."
        },
        "foundingYear": {
          "type": "number",
          "description": "The year the business started (v0.8), for schema.org `foundingDate`. Distinct from `copy.tenure`, which is a copy input that goes stale every January.",
          "minimum": 1800,
          "maximum": 2100
        },
        "priceRange": {
          "type": "string",
          "description": "schema.org `priceRange` (v0.8): `$` to `$$$$`. Optional because most clients never state one.",
          "pattern": "^\\${1,4}$"
        }
      },
      "required": [
        "trade",
        "town",
        "serviceAreaTowns",
        "address",
        "geo",
        "openingHours",
        "phone",
        "email",
        "siteUrl"
      ],
      "additionalProperties": false,
      "description": "The business's structured facts. `phone` is the **Holland tracking number** — the one every call button dials and every call is counted on — which may differ from the client's own line."
    },
    "Trade": {
      "type": "string",
      "enum": [
        "hvac",
        "plumbing",
        "pest-control",
        "electrical",
        "garage-door",
        "appliance-repair",
        "restoration",
        "cleaning",
        "landscaping",
        "tree-service",
        "junk-removal",
        "roofing",
        "painting",
        "fence-deck",
        "auto-repair",
        "pool-service",
        "handyman",
        "gutters",
        "pressure-washing",
        "other"
      ]
    },
    "PostalAddress": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string",
          "description": "`streetAddress`: \"1700 Broadway, Suite 200\"."
        },
        "locality": {
          "type": "string",
          "description": "`addressLocality`: the town or city."
        },
        "region": {
          "type": "string",
          "description": "`addressRegion`: the state, as its postal abbreviation (\"CO\")."
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code.",
          "pattern": "^[A-Z]{2}$"
        }
      },
      "required": [
        "street",
        "locality",
        "region",
        "postalCode",
        "country"
      ],
      "additionalProperties": false,
      "description": "A postal address, in schema.org `PostalAddress` terms."
    },
    "Geo": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false
    },
    "OpeningHours": {
      "type": "object",
      "properties": {
        "dayOfWeek": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DayOfWeek"
          }
        },
        "opens": {
          "type": "string",
          "description": "24-hour `HH:MM`.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "closes": {
          "type": "string",
          "description": "24-hour `HH:MM`.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "required": [
        "dayOfWeek",
        "opens",
        "closes"
      ],
      "additionalProperties": false,
      "description": "One row of opening hours, shaped so it serialises straight into a schema.org `OpeningHoursSpecification` (`dayOfWeek`, `opens`, `closes`). 24/7 is every day, `00:00`–`23:59`."
    },
    "DayOfWeek": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ]
    },
    "PricingSection": {
      "type": "object",
      "properties": {
        "intro": {
          "$ref": "#/definitions/Intro"
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PricingPlan"
          },
          "minItems": 1
        }
      },
      "required": [
        "intro",
        "plans"
      ],
      "additionalProperties": false,
      "description": "The pricing section: its intro and the plans, in display order."
    },
    "Intro": {
      "type": "object",
      "properties": {
        "chip": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "copy": {
          "type": "string"
        }
      },
      "required": [
        "chip",
        "heading",
        "copy"
      ],
      "additionalProperties": false
    },
    "PricingPlan": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "description": "In whole currency units or with cents (89, 19.5). A number, not a string, so it can become a schema.org `Offer.price`; a template formats it.",
          "minimum": 0
        },
        "cadence": {
          "$ref": "#/definitions/PricingCadence"
        },
        "blurb": {
          "type": "string",
          "description": "One or two sentences under the price."
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What the plan includes, one line each."
        },
        "cta": {
          "$ref": "#/definitions/NavLink"
        },
        "recommended": {
          "type": "boolean",
          "description": "The plan a template highlights. At most one should set it; templates highlight the first."
        }
      },
      "required": [
        "name",
        "price",
        "cadence",
        "features",
        "cta"
      ],
      "additionalProperties": false,
      "description": "One published plan or price (\"Standard Tune-Up, $89 per visit\"; \"Comfort Club, $19 a month\"). A handful per site at most, so plans live on the `site` document rather than in a collection of their own."
    },
    "PricingCadence": {
      "type": "string",
      "enum": [
        "visit",
        "month",
        "year",
        "one-time"
      ],
      "description": "How often a plan's `price` is charged."
    },
    "CopyInputs": {
      "type": "object",
      "properties": {
        "businessName": {
          "type": "string",
          "description": "Always equal to `site.name` when both are set; `validateSiteContent` enforces it."
        },
        "town": {
          "type": "string"
        },
        "primaryService": {
          "type": "string",
          "description": "The service the copy leads with (\"AC repair\")."
        },
        "differentiator": {
          "$ref": "#/definitions/Differentiator"
        },
        "tenure": {
          "type": [
            "number",
            "null"
          ],
          "description": "Years in business, or `null` when the client has not said — distinct from absent, which means the copy block was never filled in.",
          "minimum": 0
        }
      },
      "required": [
        "businessName",
        "town",
        "primaryService",
        "differentiator",
        "tenure"
      ],
      "additionalProperties": false,
      "description": "The five inputs the generator interpolates into a fixed per-trade copy block. These are *inputs*, not output slots: the hero headline, subhead, about copy, CTA and meta description are derived from them when a site is generated, and stored in their own fields above, never here."
    },
    "Differentiator": {
      "type": "string",
      "enum": [
        "same-day",
        "24-7",
        "family-owned",
        "licensed-insured",
        "free-estimates",
        "none"
      ],
      "description": "The one thing a client says sets them apart; the generator picks a copy block per value."
    },
    "SiteFlags": {
      "type": "object",
      "properties": {
        "reviewsFromGbp": {
          "type": "boolean",
          "description": "The review count and rating come from the Google Business Profile, not from typed copy."
        },
        "isPreview": {
          "type": "boolean",
          "description": "A preview of a site not yet sold or not yet live: templates may watermark it or noindex it."
        }
      },
      "additionalProperties": false,
      "description": "Build-time switches the content carries rather than the environment. Each is off unless present and `true`; content mapped from the hub carries a flag only when it is on."
    },
    "EmergencyService": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "hours": {
          "type": "string",
          "description": "When emergency calls are taken, as the business words it (\"24/7, holidays included\")."
        }
      },
      "required": [
        "available"
      ],
      "additionalProperties": false,
      "description": "Whether the business takes emergency calls, and when. HVAC reads it (a no-heat call at 2 a.m. is the job); a lawn-care site leaves it out."
    },
    "HvacSystem": {
      "type": "string",
      "enum": [
        "furnace",
        "heat-pump",
        "central-air",
        "ductless",
        "boiler",
        "water-heater"
      ]
    },
    "ServiceSeason": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/Month"
        },
        "to": {
          "$ref": "#/definitions/Month"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "description": "The months a seasonal business works (\"March to November\"). Wraps the year when `to` < `from`."
    },
    "Month": {
      "type": "string",
      "enum": [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
      ]
    },
    "HeroMedia": {
      "type": "object",
      "properties": {
        "video": {
          "type": "string",
          "description": "The background video: an absolute URL in CMS mode, a `public/` path standalone. Absent when the tenant uploaded none — stock footage is scarce for some trades, so the hub field is optional and a template must fall back to `poster` alone rather than render a `<video>` with no source."
        },
        "poster": {
          "$ref": "#/definitions/Photo"
        },
        "avatars": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Photo"
          }
        }
      },
      "required": [
        "poster",
        "avatars"
      ],
      "additionalProperties": false,
      "description": "The hero's media, from `site.heroVideo` / `heroPoster` / `avatars`. A template's own copy lives in `src/data/hero.ts`, which is also what `site-cms export-content` reads for the basenames to seed."
    },
    "Photo": {
      "description": "An image: an absolute media URL with its intrinsic size, or — in a content file before upload — a basename with zero dimensions.",
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "width",
        "height"
      ]
    },
    "AboutCard": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false,
      "description": "One card in the about section."
    },
    "ShortIntro": {
      "type": "object",
      "properties": {
        "chip": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        }
      },
      "required": [
        "chip",
        "heading"
      ],
      "additionalProperties": false
    },
    "Service": {
      "type": "object",
      "properties": {
        "icon": {
          "$ref": "#/definitions/ServiceIcon"
        },
        "title": {
          "type": "string"
        },
        "blurb": {
          "type": "string"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "$ref": "#/definitions/Photo"
        },
        "imageAlt": {
          "type": "string"
        },
        "priceHint": {
          "type": "string",
          "description": "A short price cue (\"From $89\", \"Free estimate\"). Free text: trades price too differently to type."
        },
        "slug": {
          "type": "string",
          "description": "The service's URL segment (v0.8), for templates that give each service its own page. Absent: a template derives one from `title`. Set it to keep a URL stable when the title changes.",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "answer": {
          "type": "string",
          "description": "A direct 40–60 word answer to \"what is this service and who needs it\" (v0.8), which a service page opens with — the passage answer engines quote."
        },
        "seasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Season"
          },
          "description": "When the service is offered (v0.9, seasonal trades): \"aeration\" in spring and fall. Absent: always."
        }
      },
      "required": [
        "icon",
        "title",
        "blurb",
        "bullets",
        "image",
        "imageAlt"
      ],
      "additionalProperties": false,
      "description": "The hub's `services` collection."
    },
    "ServiceIcon": {
      "type": "string",
      "enum": [
        "heating",
        "cooling",
        "air-flow",
        "air-quality",
        "water-drop",
        "pipe",
        "faucet",
        "drain",
        "power-bolt",
        "outlet",
        "lighting",
        "wrench",
        "hammer",
        "toolbox",
        "paint-roller",
        "spray",
        "pressure-wash",
        "haul-truck",
        "waste-bin",
        "roof",
        "wall",
        "door",
        "leaf",
        "tree",
        "flower",
        "sun",
        "mower",
        "fence",
        "vehicle",
        "pest",
        "rodent",
        "shield",
        "emergency",
        "certified",
        "schedule",
        "phone"
      ],
      "description": "One icon from the shared vocabulary. The hub's `services.icon` select offers exactly these."
    },
    "Season": {
      "type": "string",
      "enum": [
        "spring",
        "summer",
        "fall",
        "winter",
        "year-round"
      ]
    },
    "GalleryImage": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/Photo"
        },
        "alt": {
          "type": "string"
        },
        "emphasis": {
          "type": "string",
          "enum": [
            "featured",
            "standard"
          ],
          "description": "How much room the image gets in the desktop gallery grid."
        },
        "title": {
          "type": "string",
          "description": "The job's name (v0.8): \"High-efficiency AC retrofit\". Absent: the project is a photo only, which is all a v0.7 gallery has."
        },
        "summary": {
          "type": "string",
          "description": "One or two sentences on what was done (v0.8)."
        },
        "servicesProvided": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The services the job involved, one short line each (v0.8)."
        },
        "beforeImage": {
          "$ref": "#/definitions/Photo",
          "description": "The same spot before the work (v0.8). When set, a template may render a before/after slider between it and `image`; `alt` must then describe both."
        }
      },
      "required": [
        "image",
        "alt",
        "emphasis"
      ],
      "additionalProperties": false,
      "description": "The hub's `projects` collection — the work gallery."
    },
    "Testimonial": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "image": {
          "$ref": "#/definitions/Photo",
          "description": "The photo for this story, if there is one. HVAC and plumbing rarely have one, so a card can be quote-only."
        },
        "beforeImage": {
          "$ref": "#/definitions/Photo",
          "description": "The same property before the work. Only meaningful alongside `image`: when both are set a template may render a before/after slider between them, otherwise `image` is shown on its own."
        },
        "alt": {
          "type": "string"
        },
        "rating": {
          "type": "number",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "Star rating, when the review had one."
        },
        "date": {
          "type": "string",
          "description": "When it was written, as an ISO date.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "$ref": "#/definitions/TestimonialSource",
          "description": "Where it was posted. `direct` is a review given to the business, not on a platform."
        },
        "role": {
          "type": "string",
          "description": "Who the reviewer is to the business (v0.8): \"Homeowner\", \"Property manager\"."
        }
      },
      "required": [
        "quote",
        "author",
        "alt"
      ],
      "additionalProperties": false,
      "description": "The hub's `testimonials` collection."
    },
    "TestimonialSource": {
      "type": "string",
      "enum": [
        "google",
        "facebook",
        "yelp",
        "nextdoor",
        "direct"
      ]
    },
    "ProcessStep": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false,
      "description": "The hub's `process-steps` collection."
    },
    "Stat": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "description": "The hub's `stats` collection."
    },
    "Faq": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "additionalProperties": false,
      "description": "The hub's `faqs` collection."
    }
  }
}
